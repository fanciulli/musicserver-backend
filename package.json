{
  "name": "musicserver",
  "version": "1.0.0-alpha2",
  "description": "A music server with pluggable capbilities",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=test/e2e/playwright.config.ts",
    "start": "npm run build; cd dist; node index.js",
    "build": "npx tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/wizards','dist/wizards',{recursive:true})\"",
    "knip": "knip"
  },
  "author": "Massimiliano Fanciulli",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "fastify": "5.8.5",
    "fastify-auth-by-api-key": "1.1.0",
    "mongodb": "7.3.0",
    "music-metadata": "11.13.0",
    "selfsigned": "^5.5.0",
    "uuid": "14.0.1"
  }
}
