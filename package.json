    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "fastify": "5.8.5",
    "fastify-auth-by-api-key": "1.1.0",
    "mongodb": "7.2.0",
